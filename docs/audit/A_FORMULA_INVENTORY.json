  "line": 138,
  "section": "Stage 2: Layout-Aware Fine-Tuning",
  "equation": "7a",
  "raw_span": "\\mathcal{L}_{\\text{layout}}^{q2g} = -\\log \\frac{\\exp(\\operatorname{sim}(e_{\\text{query}}, e_{\\text{gallery}}) / \\tau)}{\\sum_{e'_{\\text{gallery}} \\in \\mathcal{B}} \\exp(\\operatorname{sim}(e_{\\text{query}}, e'_{\\text{gallery}}) / \\tau)} \\quad (7a)",
