  "equation": null,
  "raw_span": "\\tilde{x}_i^T \\tilde{x}_i - 2 \\tilde{x}_i^T \\tilde{x}_j + \\tilde{x}_j^T \\tilde{x}_j = \\ell_2(\\tilde{x}_i, \\tilde{x}_j)^2 = \\ell_2(\\tilde{y}_i, \\tilde{y}_j)^2 = \\tilde{y}_i^T \\tilde{y}_i - 2 \\tilde{y}_i^T \\tilde{y}_j + \\tilde{y}_j^T \\tilde{y}_j",
