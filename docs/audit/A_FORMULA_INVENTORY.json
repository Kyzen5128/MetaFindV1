  "equation": "7b",
  "raw_span": "\\mathcal{L}_{\\text{layout}}^{g2q} = -\\log \\frac{\\exp(\\operatorname{sim}(e_{\\text{gallery}}, e_{\\text{query}}) / \\tau)}{\\sum_{e'_{\\text{query}} \\in \\mathcal{B}} \\exp(\\operatorname{sim}(e_{\\text{gallery}}, e'_{\\text{query}}) / \\tau)} \\quad (7b)",
