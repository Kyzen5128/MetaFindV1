# Large data lives on /mnt/data1/kyzen/MetaFind, reached via this symlink.
# Never commit it.
/data

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ipynb_checkpoints/

# Runtime artifacts belong under /data or ignored output/.
# Small numerical inspection evidence under docs/audit may be explicitly staged
# after review; never blanket force-add data or checkpoints.
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.faiss
*.parquet
runs/
outputs/
# BlenderProc's default HDF5 dump lands in `output/` -- SINGULAR. The line above
# is `outputs/` and does not match it, so 0.hdf5 sat untracked-but-not-ignored
# and any `git add -A` would have swept it in. Added 2026-08-23 by Master after
# exactly that mechanism mixed three roles' work into one commit (R-13.b).
output/

# Env / secrets
.env
*.key
credentials.json

# OS / editor
.DS_Store
.vscode/
.idea/

# pytest
.pytest_cache/

# graphify skill scratch (incomplete run; regenerable)
graphify-out/

# Paper text sources and SOURCE_MANIFEST.json are tracked; the manifest is
# provenance metadata, not paper-content authority. Binary figures are excluded.
# Verify each manifest's archive path and hash before claiming that a fresh clone
# can regenerate the figures: an archive reference alone does not ensure availability.
docs/paper/*_source/**/*.pdf
docs/paper/*_source/**/*.png
docs/paper/*_source/**/*.jpg
docs/paper/*_source/**/*.eps
graphify-out/

# Local Claude / Graphify settings
CLAUDE.md
.claude/
graphify-out/

# Workflow session continuity — local working memory, never commit
/Session Handoff.md
/workflow/MASTER_SESSION_HANDOFF.md
/workflow/decisions/*_SESSION_HANDOFF.md
/workflow/tasks/*/SESSION_HANDOFF.md
