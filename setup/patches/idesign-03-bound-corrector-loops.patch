+# ---------------------------------------------------------------------------
+# [MetaFind patch, not upstream] Bounds for the two correction loops.
+#
+# Upstream writes `while len(conflicts) > 0:` with no iteration limit. It
+# terminates only if the corrector shrinks the conflict set. Measured with
+# Qwen2.5-7B: the corrector returned schema-valid JSON that did not resolve the
+# conflict, so the loop ran without end -- 236 identical rounds and a 34 MB log
+# inside 25 seconds, with the GPU idle because nothing new was being generated.
+#
+# In the graph-engineering terms this project uses, the loop had a semantic exit
+# but no progress measure, no hard bound and no exhaustion outcome. This adds
+# the missing three.
+#
+# The exhaustion outcome deliberately RAISES rather than repairing the layout
+# by hand. Inventing a resolution would mean inventing I-Design's spatial
+# semantics; abandoning the scene keeps the failure visible and countable. If
+# the drop rate turns out high, that is evidence for a larger planner model,
+# not something to paper over.
+IDESIGN_DEBUG = os.environ.get("IDESIGN_DEBUG") == "1"
+MAX_CORRECTION_ROUNDS = 12
+MAX_ATTEMPTS_PER_CONFLICT = 3
+
+
+class CorrectionNotConverging(RuntimeError):
+    """The corrector agent stopped making progress; abandon this scene."""
+
